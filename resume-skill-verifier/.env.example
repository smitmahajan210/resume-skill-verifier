# Copy this file to .env and fill in your values
# Used by docker-compose.yml (all fields have safe defaults for local dev)

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=resume_db

# Backend — connection string assembled from above values
DATABASE_URL=postgresql://postgres:password@db:5432/resume_db

# Frontend — base URL the browser uses to reach the API
# In Docker Compose the frontend container talks to the backend container by
# service name, but browser-side requests still go via the host machine.
# For local Docker: keep http://localhost:8000
# For production: set to your public API domain
NEXT_PUBLIC_API_URL=http://localhost:8000
